# ==========================================================
# Arabic Detection
# ==========================================================

ARABIC_PATTERN = re.compile(
    r'[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF]'
)

ARABIC_WORD_PATTERN = re.compile(
    r'[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF]+'
)

def contains_arabic(text):
    return isinstance(text, str) and bool(ARABIC_PATTERN.search(text))


# ==========================================================
# Dictionary Loader
# ==========================================================

def load_dictionary(dictionary_file):

    wb = load_workbook(dictionary_file, data_only=True)
    ws = wb.active

    dictionary = {}

    for row in ws.iter_rows(min_row=2, values_only=True):

        if not row:
            continue

        source = row[0]
        target = row[1] if len(row) > 1 else None

        if source and target:

            normalized_source = normalize_text(source)

            dictionary[normalized_source] = str(target).strip()

    return dictionary


# ==========================================================
# Merged Cell Helpers
# ==========================================================

def is_merged_child(ws, cell):

    for merged_range in ws.merged_cells.ranges:

        if cell.coordinate in merged_range:

            master = ws.cell(
                merged_range.min_row,
                merged_range.min_col
            )

            return cell.coordinate != master.coordinate

    return False


def get_actual_value(ws, cell):

    for merged_range in ws.merged_cells.ranges:

        if cell.coordinate in merged_range:

            return ws.cell(
                merged_range.min_row,
                merged_range.min_col
            ).value

    return cell.value


# ==========================================================
# Apply LTR ONLY to translated cells
# ==========================================================

def apply_ltr(cell):
    cell.alignment = Alignment(
        horizontal="left",
        vertical="center",
        wrap_text=False,
        readingOrder=1,
        indent=0
    )


def normalize_sheet_title(title):
    """
    Excel title constraints:
    - Max length 31
    - Invalid chars: : \\ / ? * [ ]
    """

    cleaned = re.sub(r'[:\\/?*\[\]]', ' ', str(title))
    cleaned = re.sub(r'\s+', ' ', cleaned).strip()

    if not cleaned:
        cleaned = "Sheet"

    return cleaned[:31]


def make_unique_sheet_title(base_title, used_titles):
    """
    Ensure translated sheet names are unique within workbook.
    """

    candidate = base_title

    if candidate not in used_titles:
        return candidate

    index = 2

    while True:
        suffix = f" ({index})"
        trimmed = base_title[:31 - len(suffix)].rstrip()
        candidate = f"{trimmed}{suffix}"

        if candidate not in used_titles:
            return candidate

        index += 1


def _quote_sheet_name(name):
    return "'" + str(name).replace("'", "''") + "'"


def update_formula_sheet_references(formula, title_map):
    """
    Rewrite formula sheet references after tab renaming.
    Supports both quoted and unquoted sheet names.
    """

    if not isinstance(formula, str) or not formula.startswith("="):
        return formula

    updated = formula

    for old_title, new_title in title_map.items():
        if old_title == new_title:
            continue

        # Quoted: 'Old Name'!A1  ->  'New Name'!A1
        old_quoted = _quote_sheet_name(old_title)
        new_quoted = _quote_sheet_name(new_title)
        updated = updated.replace(f"{old_quoted}!", f"{new_quoted}!")

        # Unquoted: OldName!A1 -> NewName!A1
        # Only safe for names without spaces/special chars.
        if re.match(r'^[A-Za-z0-9_.]+$', old_title):
            pattern = re.compile(r'(?<![A-Za-z0-9_\.])' + re.escape(old_title) + r'!')
            updated = pattern.sub(f"{new_title}!", updated)

    return updated


# ==========================================================
# Translation
# ==========================================================

def build_translation_pattern(dictionary):
    """
    Build ONE compiled regex that matches any dictionary key, but only
    as a WHOLE word/phrase (never as a fragment inside another word).

    Keys are ordered so longer phrases (more words, then more characters)
    are tried before shorter ones, so multi-word phrases win over any
    single word/letter that might also be a key.
    """

    if not dictionary:
        return None

    sorted_keys = sorted(
        dictionary.keys(),
        key=lambda k: (len(k.split()), len(k)),
        reverse=True
    )

    joined = "|".join(re.escape(key) for key in sorted_keys)

    # (?<!\w) / (?!\w) are Unicode-aware word boundaries: they treat
    # Arabic letters as "word" characters, so a match can only start/end
    # at whitespace, punctuation (including "-"), or string start/end.
    return re.compile(r'(?<!\w)(?:' + joined + r')(?!\w)')


def collapse_letter_hyphens(text):
    """
    Convert outputs like "t-r-a-n-s-l-a-t-i-o-n" into "translation".
    """

    if not isinstance(text, str) or "-" not in text:
        return text

    letter_chain = re.compile(r'\b(?:[A-Za-z]\s*-\s*){2,}[A-Za-z]\b')

    return letter_chain.sub(
        lambda m: re.sub(r'\s*-\s*', '', m.group(0)),
        text
    )


def translate_text(text, dictionary, missing_terms):

    original = str(text)

    normalized_original = normalize_text(original)

    # Exact match after normalization (whole cell matches a dictionary entry)
    if normalized_original in dictionary:
        return collapse_letter_hyphens(dictionary[normalized_original])

    translated_parts = []
    last_end = 0
    translated_any = False

    for match in ARABIC_WORD_PATTERN.finditer(original):
        start, end = match.span()
        arabic_word = match.group(0)

        translated_parts.append(original[last_end:start])

        normalized_word = normalize_text(arabic_word)

        if normalized_word in dictionary:
            translated_parts.append(dictionary[normalized_word])
            translated_any = True
        else:
            translated_parts.append(arabic_word)
            missing_terms.add(arabic_word)

        last_end = end

    translated_parts.append(original[last_end:])

    if not translated_any:
        return original

    translated = ''.join(translated_parts)
    translated = collapse_letter_hyphens(translated)

    return translated


# ==========================================================
# Missing Words Report
# ==========================================================

def save_missing_terms(missing_terms, source_file):

    wb = Workbook()
    ws = wb.active

    ws.title = "Missing Arabic Words"
    ws["A1"] = "Arabic Text Not Found"

    row = 2

    for word in sorted(missing_terms):
        ws.cell(row=row, column=1, value=word)
        row += 1

    missing_file = os.path.join(
        os.path.dirname(source_file),
        "Missing_Arabic_Words.xlsx"
    )

    wb.save(missing_file)

    return missing_file

